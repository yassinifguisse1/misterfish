# Cloudflare R2 — copy this file to .env.local and fill in your values.
# Never commit .env.local to git.

# From R2 API token screen
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# From the S3 endpoint URL: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# Your R2 bucket name (create in Cloudflare → R2)
R2_BUCKET_NAME=misterfish-menu

# Public URL where images are served (R2 bucket → Settings → Public access → R2.dev URL)
# Example: https://pub-abc123.r2.dev
NEXT_PUBLIC_R2_PUBLIC_URL=
